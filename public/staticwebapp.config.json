{
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate"
      }
    },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/activities/sound-paint", "rewrite": "/index.html" },
    { "route": "/activities/shape-story", "rewrite": "/index.html" },
    { "route": "/activities/flip-cards", "rewrite": "/index.html" },
    { "route": "/activities/rhythm-press", "rewrite": "/index.html" },
    { "route": "/activities/creature-works", "rewrite": "/index.html" },
    { "route": "/activities/shadow-page", "rewrite": "/index.html" },
    { "route": "/demo/activities/sound-paint", "rewrite": "/index.html" },
    { "route": "/demo/activities/shape-story", "rewrite": "/index.html" },
    { "route": "/demo/activities/flip-cards", "rewrite": "/index.html" },
    { "route": "/demo/activities/rhythm-press", "rewrite": "/index.html" },
    { "route": "/demo/activities/creature-works", "rewrite": "/index.html" },
    { "route": "/demo/activities/shadow-page", "rewrite": "/index.html" }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.sociobot.in; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://api.sociobot.in; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
